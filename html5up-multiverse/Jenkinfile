pipeline {
    agent any

    environment {
        // Nexus
        NEXUS_URL = "http://99.79.76.192:8081/repository/Multiverse/"
        NEXUS_USER = "admin"
        NEXUS_PASS = "admin"

        // Ubuntu EC2
        EC2_HOST = "3.99.252.7"
        EC2_USER = "ubuntu"
        SSH_KEY = "Multiverse.pem"

        // SonarQube
        SONARQUBE_SERVER = "SonarQ" // Jenkins configured SonarQube server name
        SONAR_PROJECT_KEY = "Multiverse"
        SONAR_PROJECT_NAME = "Multiverse"
        SONAR_LOGIN = "sqa_a8f9d8f81579535cc4e1c3b5c3f9b1fe86e8264c"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gkj-git/Multiverse.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(SONARQUBE_SERVER) {
                    sh """
                    sonar-scanner \
                        -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                        -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=${SONARQUBE_SERVER} \
                        -Dsonar.login=${SONAR_LOGIN} \
                        -Dsonar.sourceEncoding=UTF-8 \
                        -Dsonar.language=js
                    """
                }
            }
        }

        stage('Package Website') {
            steps {
                sh 'zip -r website.zip .'
            }
        }

        stage('Upload to Nexus') {
            steps {
                sh """
                curl -v -u ${NEXUS_USER}:${NEXUS_PASS} --upload-file website.zip \
                ${NEXUS_URL}/website-${BUILD_NUMBER}.zip
                """
            }
        }

        stage('Deploy to Ubuntu EC2') {
            steps {
                sh """
                scp -o StrictHostKeyChecking=no -i ${SSH_KEY} website.zip ${EC2_USER}@${EC2_HOST}:/home/ubuntu/

                ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ${EC2_USER}@${EC2_HOST} "
                cd /home/ubuntu
                sudo rm -rf /var/www/html/*
                sudo unzip -o website.zip -d /var/www/html/"

                "
                """
            }
        }
    }

    post {
        success {
            echo "Deployment completed successfully!"
        }
        failure {
            echo "Deployment failed. Check logs."
        }
    }
}
