pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/gkj-git/Multiverse.git'
            }
        }

        stage('Package ZIP') {
            steps {
                sh 'zip -r Multiverse.zip .'
            }
        }

        stage('Upload to Nexus') {
            steps {
                sh '''
                curl -v -u admin:admin --upload-file Mutliverse.zip \
                http://99.79.76.192:8081/repository/Multiverse/Multiverse-${BUILD_NUMBER}.zip
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                sh '''
                scp -i Multiverse.pem Multiverse.zip ec2-user@IP:3.99.252.7 "sudo /var/www/html/Multiverse.zip -d /var/www/html/"
            }
        }
    }
}
